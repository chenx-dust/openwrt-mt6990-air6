#!/bin/sh
# Restore B-slot CONN_RO/GNSS before network, Wi-Fi and modem startup.

lg6851f_repair_connsys_gnss_b() {
	grep -aq 'fiberhome,lg6851f' /proc/device-tree/compatible 2>/dev/null || return 0
	/usr/sbin/lg6851f-repair-connsys-gnss-b >/dev/null 2>&1 || true
}

boot_hook_add preinit_main lg6851f_repair_connsys_gnss_b
